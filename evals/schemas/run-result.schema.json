{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/run-result.schema.json",
  "title": "LogicLens Evaluation Run Result 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "case_id",
    "track",
    "condition",
    "repetition",
    "sequence_index",
    "harness",
    "model",
    "environment",
    "timing",
    "usage",
    "status",
    "output",
    "artifacts",
    "error"
  ],
  "properties": {
    "contract_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "track": {"enum": ["controlled_model", "native_default"]},
    "condition": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 1},
    "sequence_index": {"type": "integer", "minimum": 1},
    "harness": {"$ref": "#/$defs/harness"},
    "model": {"$ref": "#/$defs/model"},
    "environment": {"$ref": "#/$defs/environment"},
    "timing": {"$ref": "#/$defs/timing"},
    "usage": {"$ref": "#/$defs/usage"},
    "status": {"enum": ["completed", "failed", "timed_out"]},
    "output": {"$ref": "#/$defs/output"},
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "name", "version"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version", "configuration"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "configuration": {"type": "object"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_snapshot_id",
        "network_access",
        "history_access",
        "clean_workspace",
        "prompt_wrapper",
        "logiclens"
      ],
      "properties": {
        "repository_snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "network_access": {"type": "boolean"},
        "history_access": {"type": "boolean"},
        "clean_workspace": {"type": "boolean"},
        "prompt_wrapper": {"type": "string"},
        "logiclens": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["commit", "version", "index_wall_ms"],
              "properties": {
                "commit": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "index_wall_ms": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "wall_ms"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "wall_ms": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "tool_calls",
        "raw_files_read"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "raw_files_read": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "output": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "value", "raw_output_path"],
          "properties": {
            "schema": {"type": "string", "minLength": 1},
            "value": {"type": "object"},
            "raw_output_path": {"type": ["string", "null"]}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"condition": {"const": "native"}}},
      "then": {
        "properties": {
          "environment": {
            "properties": {"logiclens": {"type": "null"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"condition": {"const": "logiclens"}}},
      "then": {
        "properties": {
          "environment": {
            "properties": {"logiclens": {"type": "object"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "properties": {
          "output": {"type": "object"},
          "error": {"type": "null"}
        }
      },
      "else": {"properties": {"error": {"type": "string", "minLength": 1}}}
    }
  ]
}
