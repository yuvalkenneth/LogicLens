{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/harness-adapter.schema.json",
  "title": "LogicLens Harness Adapter Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "adapter_id",
    "adapter_version",
    "harness_name",
    "supported_tracks",
    "capabilities"
  ],
  "properties": {
    "contract_version": {"const": "0.1"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "adapter_version": {"type": "string", "minLength": 1},
    "harness_name": {"type": "string", "minLength": 1},
    "supported_tracks": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["controlled_model", "native_default"]},
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_override",
        "structured_output",
        "token_usage",
        "cost_usage",
        "tool_trace",
        "raw_file_trace"
      ],
      "properties": {
        "model_override": {"type": "boolean"},
        "structured_output": {"type": "boolean"},
        "token_usage": {"type": "boolean"},
        "cost_usage": {"type": "boolean"},
        "tool_trace": {"type": "boolean"},
        "raw_file_trace": {"type": "boolean"}
      }
    }
  }
}
