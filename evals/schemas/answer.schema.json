{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/answer.schema.json",
  "title": "LogicLens Harness-Neutral Answer 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "turns"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/turnAnswer"}
    }
  },
  "$defs": {
    "turnAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "summary", "claims", "relations", "reading_order", "unknowns"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "reading_order": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "stance", "confidence", "evidence"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "stance": {"enum": ["confirmed", "inferred", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/evidence.schema.json"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"stance": {"enum": ["confirmed", "inferred"]}}
          },
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "source", "kind", "target", "confidence", "evidence"],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/evidence.schema.json"
          }
        }
      }
    }
  }
}
