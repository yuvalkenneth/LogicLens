{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/eval-case.schema.json",
  "title": "LogicLens Evaluation Case 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "target",
    "repository",
    "agent_input",
    "oracle",
    "protocol"
  ],
  "properties": {
    "contract_version": {"const": "0.1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "target": {"$ref": "#/$defs/target"},
    "repository": {"$ref": "#/$defs/repository"},
    "agent_input": {"$ref": "#/$defs/agentInput"},
    "oracle": {"$ref": "#/$defs/oracle"},
    "protocol": {"$ref": "#/$defs/protocol"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["role", "end_to_end"]},
        "name": {"type": "string", "minLength": 1},
        "role_definition": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "role"}}},
          "then": {"required": ["role_definition"]}
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_path", "snapshot_id", "current_snapshot_only"],
      "properties": {
        "fixture_path": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "current_snapshot_only": {"const": true},
        "languages": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "agentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "artifacts", "output_schema"],
      "properties": {
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/turn"}
        },
        "artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "output_schema": {"type": "string", "minLength": 1}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "category", "prompt"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "repository_overview",
            "entry_points",
            "business_flow",
            "implementation_location",
            "dependency_impact",
            "reading_order",
            "unanswerable",
            "role_task"
          ]
        },
        "prompt": {"type": "string", "minLength": 1}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "expected_unknowns",
        "expected_decisions",
        "success_criteria"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/goldFact"}
        },
        "expected_unknowns": {
          "type": "array",
          "items": {"$ref": "#/$defs/expectedUnknown"}
        },
        "expected_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/expectedDecision"}
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/successCriterion"}
        },
        "relation_oracle_path": {"type": "string", "minLength": 1}
      }
    },
    "goldFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "statement", "importance", "applies_to_turns", "evidence"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "importance": {"enum": ["required", "optional"]},
        "applies_to_turns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://github.com/yuvalkenneth/LogicLens/evals/schemas/evidence.schema.json"
          }
        }
      }
    },
    "expectedUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "statement", "applies_to_turns", "search_scope"],
      "properties": {
        "unknown_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "applies_to_turns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "search_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "expectedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "decision"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["accept", "reject", "revise", "invoke", "skip"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "successCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "description", "weight", "oracle_ids"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "oracle_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "tracks",
        "repetitions",
        "network_access",
        "history_access",
        "clean_workspace",
        "randomize_condition_order",
        "allow_targeted_source_reads",
        "count_indexing_cost",
        "budget"
      ],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"},
          "uniqueItems": true
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["controlled_model", "native_default"]},
          "uniqueItems": true
        },
        "repetitions": {"type": "integer", "minimum": 3},
        "network_access": {"const": false},
        "history_access": {"const": false},
        "clean_workspace": {"const": true},
        "randomize_condition_order": {"type": "boolean"},
        "allow_targeted_source_reads": {"type": "boolean"},
        "count_indexing_cost": {"type": "boolean"},
        "budget": {"$ref": "#/$defs/budget"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "logiclens_enabled"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "logiclens_enabled": {"type": "boolean"},
        "instructions": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "input_tokens", "output_tokens"],
      "properties": {
        "wall_seconds": {"type": ["integer", "null"], "minimum": 1},
        "input_tokens": {"type": ["integer", "null"], "minimum": 1},
        "output_tokens": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
